# Copy this to .env and fill in your values

# Flask secret key — change this to a long random string
SECRET_KEY=your-super-secret-key-here

# Admin panel password (plain text; will be hashed on first run)
ADMIN_PASSWORD=admin1234

# WhatsApp number WITHOUT + sign (e.g. Saudi number: 966501234567)
WHATSAPP_NUMBER=966500000000

# Optional: override database path
# DATABASE_URL=sqlite:///cars.db
